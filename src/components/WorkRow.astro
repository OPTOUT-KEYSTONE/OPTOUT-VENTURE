---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'products'>;
}

const { entry } = Astro.props;
const { title, summary } = entry.data;
---

<a
  href={`/products/${entry.id}`}
  class="group border-line hover:border-signal flex items-center justify-between gap-4 border-b py-5 transition-colors sm:gap-6"
>
  <span class="min-w-0">
    <span
      class="font-display text-ink group-hover:text-signal block truncate text-lg transition-colors"
    >
      {title}
    </span>
    <span class="text-ink-soft hidden truncate text-sm sm:block">{summary}</span>
  </span>

  <span class="flex items-center gap-4">
    <span
      aria-hidden="true"
      class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
    >
      →
    </span>
  </span>
</a>
